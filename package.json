{
  "name": "overlay",
  "version": "1.0.0",
  "description": "Live Streaming Overlay",
  "main": "overlay/server.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "build:exe": "pkg ./server.js --targets node18-win-x64 --output dist/overlay.exe",
    "test": "echo \"Error: no test specified\" && exit 1",
    "init": "cp overlay.conf.example overlay.conf",
    "server": "node overlay/server.js",
    "dev": "node --watch-path=./overlay --watch-path=./overlay.conf ./server.js"
  },
  "pkg": {
    "assets": [
      "overlay/**/*",
      "overlay.conf"
    ],
    "outputPath": "dist"
  },
  "keywords": [],
  "dependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "comfy.js": "^1.1.29",
    "express": "^5.2.1",
    "open": "^11.0.4",
    "socket.io": "^4.8.4",
    "tmi.js": "^1.8.5",
    "youtubei.js": "^18.1.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.23.0",
    "browser-sync": "^2.25.0",
    "concurrently": "^10.0.5",
    "nodemon": "^1.14.10"
  }
}
