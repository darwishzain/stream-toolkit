{
    "theme":{
        "id": "cyber-cyan",
        "colors": {
            "primary": "#00f3ff",
            "secondary": "#7000ff",
            "background": "rgba(5, 11, 20, 0.85)",
            "text": "#ffffff",
            "glow": "rgba(0, 243, 255, 0.6)"
        },
        "typography": {
            "fontFamily": "'Roboto', monospace",
            "fontSizeBase": "14px"
        },
        "aesthetics": {
            "preset": "hologram",
            "effects": {
                "scanlines": {
                "enabled": true,
                "opacity": 0.2,
                "speed": "4s"
                },
                "glitch": {
                "enabled": true,
                "intensity": "subtle",
                "interval": "6s"
                },
                "glow": {
                "enabled": true,
                "blur": "12px",
                "spread": "2px"
                },
                "glassmorphism": {
                "enabled": true,
                "blur": "8px",
                "opacity": 0.75
                },
                "chromaticAberration": {
                "enabled": true,
                "offset": "2px"
                }
            }
        }
    },
    "social-ticker":{
        "duration":2000,
        "username":{
            "twitter":"twittername",
            "instagram":"instagramname",
            "twitch":"twitchname"
        }
    },
    "waving-flag":{
        "image":"https://upload.wikimedia.org/wikipedia/commons/6/61/Flag_of_Kelantan.svg"
    }
}